{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "macrohard",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"account_id": "599ac4094b1fee50c0cd0ccb90102046",

	// Custom domains: wrangler creates the DNS records + cert on deploy.
	"routes": [
		{ "pattern": "macrohard.nz", "custom_domain": true },
		{ "pattern": "www.macrohard.nz", "custom_domain": true },
	],

	// Static site. Assets are served by the platform before the Worker runs
	// for any path that matches a file; everything else falls through to src/index.ts.
	// Only these paths invoke the Worker. Requests to static assets are free and
	// unlimited, while `run_worker_first: true` billed ~7 invocations per page view
	// instead of ~2. On Workers Paid that is 10M included per month then $0.30/million,
	// so this is no longer a cliff — but it is still 3.5× the request bill for nothing,
	// and it was a hard ~14k/day ceiling on the Free plan this was first written for.
	//   "/" and "/method"  → the www→apex redirect for anything a human navigates to
	//   "/api/*", "/s/*"   → the API and personalised permalinks
	//   "/og/*"            → per-permalink share images ("/og.png" stays a static asset)
	// Unmatched paths with no asset still reach the Worker's catch-all, so the 404
	// page keeps its 404 status.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/", "/method", "/api/*", "/s/*", "/og/*"],
	},

	"kv_namespaces": [{ "binding": "KV", "id": "6316a73ae2504d40818759e3294d4ecf" }],

	"ai": { "binding": "AI" },

	// Browser Rendering renders one share image per permalink (cached in KV).
	// Free tier is minutes-per-day; when it runs out the generic card serves instead.
	"browser": { "binding": "BROWSER" },

	// Per-IP throttle on the generator. The daily cap in KV is the spend ceiling;
	// this just stops one client burning it.
	"ratelimits": [{ "name": "STAFF_RL", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],

	// Receipts refresh. ~20 unauthenticated GitHub calls per run keeps us under
	// the 60/hr anonymous ceiling; set GITHUB_TOKEN as a secret to lift it.
	"triggers": { "crons": ["*/30 * * * *"] },

	"vars": {
		"GITHUB_OWNER": "MadaBurns",
		"GITHUB_REPOS": "bv-mcp,blackveil-dns-action,bv-claude-dns,macrohard",
		"RECEIPTS_WINDOW_DAYS": "90",
		// Spend ceilings, sized against Workers Paid — NOT against request count,
		// which stopped being the binding constraint (10M/month included).
		//
		// A generation is ~66 neurons: measured 1,702 chars of prompt + schema, an
		// 881-char org, and a 726-char second guard pass, priced at the published
		// per-million-token neuron rates. 69% of that is output tokens on the 70b.
		// Workers Paid includes 10,000 neurons/day, so the first ~150 a day are free
		// and the rest cost $0.011/1,000 neurons.
		//   cap 400  -> $0.18/day   cap 1500 -> $0.98/day   cap 2000 -> $1.33/day
		// — and only on a day the cap is actually exhausted, which a spike does for
		// a day or two, not a month. 1500 is chosen so a front-page day does not
		// hand visitors the canned fallback at the one moment it matters; the worst
		// case if someone deliberately burns it daily is ~$29/month.
		"STAFF_DAILY_CAP": "1500",
		// Browser Rendering includes 10 hours/month; a card takes ~6s, so ~6,000
		// renders/month. 150/day = 4,500/month = ~7.5 hours, inside the allowance.
		// The per-id lock is what actually protects this — the risk is concurrency
		// (10 concurrent browsers included, billed on the monthly average of daily
		// peaks), not total minutes.
		"OG_DAILY_CAP": "150",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"CONTACT_EMAIL": "hello@macrohard.nz",
		"TURNSTILE_SITE_KEY": "",
	},

	"observability": { "enabled": true, "head_sampling_rate": 1 },
}
