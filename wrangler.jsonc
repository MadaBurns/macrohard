{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "macrohard",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"account_id": "599ac4094b1fee50c0cd0ccb90102046",

	// Custom domains: wrangler creates the DNS records + cert on deploy.
	"routes": [
		{ "pattern": "macrohard.nz", "custom_domain": true },
		{ "pattern": "www.macrohard.nz", "custom_domain": true },
	],

	// Static site. Assets are served by the platform before the Worker runs
	// for any path that matches a file; everything else falls through to src/index.ts.
	// Only these paths invoke the Worker. Requests to static assets are free and
	// unlimited; routing every one through the Worker (run_worker_first: true)
	// cost ~7 invocations per page view, which on the Free plan's 100k/day put the
	// ceiling around 14k views — well under what a front-page spike delivers.
	//   "/" and "/method"  → the www→apex redirect for anything a human navigates to
	//   "/api/*", "/s/*"   → the API and personalised permalinks
	//   "/og/*"            → per-permalink share images ("/og.png" stays a static asset)
	// Unmatched paths with no asset still reach the Worker's catch-all, so the 404
	// page keeps its 404 status.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/", "/method", "/api/*", "/s/*", "/og/*"],
	},

	"kv_namespaces": [{ "binding": "KV", "id": "6316a73ae2504d40818759e3294d4ecf" }],

	"ai": { "binding": "AI" },

	// Browser Rendering renders one share image per permalink (cached in KV).
	// Free tier is minutes-per-day; when it runs out the generic card serves instead.
	"browser": { "binding": "BROWSER" },

	// Per-IP throttle on the generator. The daily cap in KV is the spend ceiling;
	// this just stops one client burning it.
	"ratelimits": [{ "name": "STAFF_RL", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],

	// Receipts refresh. ~20 unauthenticated GitHub calls per run keeps us under
	// the 60/hr anonymous ceiling; set GITHUB_TOKEN as a secret to lift it.
	"triggers": { "crons": ["*/30 * * * *"] },

	"vars": {
		"GITHUB_OWNER": "MadaBurns",
		"GITHUB_REPOS": "bv-mcp,blackveil-dns-action,bv-claude-dns,macrohard",
		"RECEIPTS_WINDOW_DAYS": "90",
		"STAFF_DAILY_CAP": "400",
		"OG_DAILY_CAP": "60",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"CONTACT_EMAIL": "hello@macrohard.nz",
		"TURNSTILE_SITE_KEY": "",
	},

	"observability": { "enabled": true, "head_sampling_rate": 1 },
}
