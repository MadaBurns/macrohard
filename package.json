		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.4.0",
		"hono": "^4.9.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.0",
		"prettier": "^3.6.0",
		"typescript": "^7.0.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.61.0"
	},
	"engines": {
		"node": ">=22"
	}
}
