{
	"name": "macrohard",
	"version": "0.1.0",
	"private": true,
	"description": "macrohard.nz — the software company that runs itself. Receipts included.",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"predeploy": "npm run typecheck && npm test",
		"pretypecheck": "npm run types",
		"typecheck": "tsc --noEmit",
